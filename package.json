{
  "name": "finnn",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter api --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "lint:fix": "pnpm --filter web lint:fix",
    "format": "pnpm --filter web format",
    "format:check": "pnpm --filter web format:check",
    "check": "pnpm api:check-generated && pnpm --filter api check && pnpm --filter web check && pnpm --filter postgres-backup check",
    "check:fix": "pnpm --filter web check:fix",
    "test": "pnpm --filter api test && pnpm --filter web test && pnpm --filter postgres-backup test",
    "test:watch": "pnpm -r --parallel --filter api --filter web --filter postgres-backup test:watch",
    "typecheck": "pnpm --filter api typecheck && pnpm --filter web typecheck",
    "storybook": "pnpm --filter web storybook",
    "build:storybook": "pnpm --filter web build:storybook",
    "api:generate": "pnpm --filter api openapi:generate && pnpm --filter web api:generate",
    "api:check-generated": "node scripts/check-api-generated.mjs",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate:dev": "pnpm --filter api db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter api db:migrate:deploy",
    "db:migrate:status": "pnpm --filter api db:migrate:status",
    "db:migrate:mongo-to-postgres": "pnpm --filter api db:migrate:mongo-to-postgres",
    "db:mongo:unset-debt-account-ids": "pnpm --filter api db:mongo:unset-debt-account-ids",
    "db:seed": "pnpm --filter api db:seed",
    "db:mongo:export": "pnpm --filter api db:mongo:export",
    "db:mongo:import": "pnpm --filter api db:mongo:import",
    "backup:postgres": "pnpm --filter postgres-backup start",
    "backup:decrypt": "pnpm --filter postgres-backup decrypt",
    "backup:test": "pnpm --filter postgres-backup test",
    "ngrok": "pnpm --filter api ngrok",
    "telegram:webhook:enable": "pnpm --filter api telegram:webhook:enable"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/cli>typescript": "6.0.3"
    }
  }
}
