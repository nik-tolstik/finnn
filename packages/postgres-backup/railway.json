{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/postgres-backup/Dockerfile",
    "watchPatterns": ["/packages/postgres-backup/**", "/package.json", "/pnpm-lock.yaml", "/pnpm-workspace.yaml"]
  },
  "deploy": {
    "cronSchedule": "0 2 * * *",
    "multiRegionConfig": {
      "europe-west4-drams3a": {
        "numReplicas": 1
      }
    },
    "restartPolicyType": "NEVER"
  }
}
