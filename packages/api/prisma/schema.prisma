generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Currency {
  USD
  EUR
  RUB
  BYN
}

model User {
  id                                 String                             @id @default(cuid())
  email                              String?                            @unique
  name                               String?
  image                              String?
  avatarStorageKey                   String?
  password                           String?
  emailVerified                      DateTime?                          @db.Timestamptz(3)
  createdAt                          DateTime                           @default(now()) @db.Timestamptz(3)
  updatedAt                          DateTime                           @updatedAt @db.Timestamptz(3)
  workspaces                         WorkspaceMember[]
  ownedWorkspaces                    Workspace[]                        @relation("WorkspaceOwner")
  accounts                           Account[]
  hiddenAccounts                     HiddenAccount[]
  createdTransfers                   TransferTransaction[]              @relation("TransferCreatedBy")
  authSessions                       AuthSession[]
  authIdentities                     AuthIdentity[]
  pendingEmailVerifications          PendingEmailVerification[]
  passwordResetCodes                 PasswordResetCode[]
  telegramBotPreference              TelegramBotPreference?
  aiFinanceDrafts                    AiFinanceDraft[]
  uploadedCategoryIconAssets         CategoryIconAsset[]                @relation("CategoryIconUploadedBy")
  createdScheduledPayments           ScheduledPayment[]                 @relation("ScheduledPaymentCreatedBy")
  assignedScheduledPayments          ScheduledPayment[]                 @relation("ScheduledPaymentAssignedTo")
  scheduledPaymentRecords            ScheduledPaymentRecord[]           @relation("ScheduledPaymentActionBy")
  scheduledPaymentReminderDeliveries ScheduledPaymentReminderDelivery[]

  @@map("users")
}

model AuthIdentity {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  username       String?
  displayName    String?
  photoUrl       String?
  linkedAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model PendingEmailVerification {
  id        String   @id @default(cuid())
  userId    String
  email     String
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([email])
  @@index([expiresAt])
  @@map("pending_email_verifications")
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    String
  email     String
  codeHash  String
  expiresAt DateTime @db.Timestamptz(3)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([email])
  @@index([expiresAt])
  @@map("password_reset_codes")
}

model AuthSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Workspace {
  id                                 String                             @id @default(cuid())
  name                               String
  slug                               String                             @unique
  baseCurrency                       String                             @default("BYN")
  ownerId                            String
  createdAt                          DateTime                           @default(now()) @db.Timestamptz(3)
  updatedAt                          DateTime                           @updatedAt @db.Timestamptz(3)
  owner                              User                               @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members                            WorkspaceMember[]
  accounts                           Account[]
  categories                         Category[]
  paymentTransactions                PaymentTransaction[]
  transferTransactions               TransferTransaction[]
  invites                            WorkspaceInvite[]
  debts                              Debt[]
  debtTransactions                   DebtTransaction[]
  scheduledPayments                  ScheduledPayment[]
  scheduledPaymentRecords            ScheduledPaymentRecord[]
  categoryIconAssets                 CategoryIconAsset[]
  scheduledPaymentReminderDeliveries ScheduledPaymentReminderDelivery[]
  telegramBotPreferences             TelegramBotPreference[]
  aiFinanceDrafts                    AiFinanceDraft[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("member")
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Account {
  id                      String                   @id @default(cuid())
  workspaceId             String
  ownerId                 String?
  name                    String
  balance                 String                   @default("0")
  initialBalance          String                   @default("0")
  currency                String                   @default("USD")
  description             String?
  color                   String?
  icon                    String?
  archived                Boolean                  @default(false)
  order                   Int                      @default(0)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(3)
  workspace               Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner                   User?                    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  hiddenForUsers          HiddenAccount[]
  paymentTransactions     PaymentTransaction[]
  outgoingTransfers       TransferTransaction[]    @relation("TransferFromAccount")
  incomingTransfers       TransferTransaction[]    @relation("TransferToAccount")
  debtTransactions        DebtTransaction[]
  scheduledPayments       ScheduledPayment[]
  scheduledPaymentRecords ScheduledPaymentRecord[]

  @@index([workspaceId, archived])
  @@index([workspaceId, ownerId, archived, order])
  @@index([ownerId])
  @@map("accounts")
}

model HiddenAccount {
  id        String   @id @default(cuid())
  accountId String
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, userId])
  @@index([userId, accountId])
  @@map("hidden_accounts")
}

model Category {
  id                      String                   @id @default(cuid())
  workspaceId             String
  iconAssetId             String?
  name                    String
  type                    String
  icon                    String?
  order                   Int                      @default(0)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(3)
  workspace               Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  iconAsset               CategoryIconAsset?       @relation(fields: [iconAssetId], references: [id], onDelete: SetNull)
  paymentTransactions     PaymentTransaction[]
  scheduledPayments       ScheduledPayment[]
  scheduledPaymentRecords ScheduledPaymentRecord[]

  @@index([workspaceId, type, order])
  @@index([iconAssetId])
  @@map("categories")
}

model CategoryIconAsset {
  id           String     @id @default(cuid())
  workspaceId  String
  uploadedById String
  storageKey   String
  isDeleting   Boolean?   @default(false)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy   User       @relation("CategoryIconUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  categories   Category[]

  @@index([workspaceId, createdAt])
  @@index([uploadedById])
  @@map("category_icon_assets")
}

model PaymentTransaction {
  id                      String                   @id @default(cuid())
  workspaceId             String
  accountId               String
  amount                  String
  type                    String
  description             String?
  date                    DateTime                 @default(now()) @db.Timestamptz(3)
  categoryId              String?
  createdByAi             Boolean?                 @default(false)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(3)
  workspace               Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account                 Account                  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category                Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  scheduledPaymentRecords ScheduledPaymentRecord[]
  debtTransactions        DebtTransaction[]

  @@index([workspaceId, date])
  @@index([workspaceId, type, date])
  @@index([workspaceId, categoryId, date])
  @@index([workspaceId, accountId, date])
  @@index([accountId, date])
  @@index([categoryId])
  @@map("transactions")
}

model TransferTransaction {
  id            String    @id @default(cuid())
  workspaceId   String
  fromAccountId String
  toAccountId   String
  createdById   String?
  amount        String
  toAmount      String
  description   String?
  date          DateTime  @default(now()) @db.Timestamptz(3)
  createdByAi   Boolean?  @default(false)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromAccount   Account   @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount     Account   @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  createdBy     User?     @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, date])
  @@index([workspaceId, createdById, date])
  @@index([workspaceId, fromAccountId, date])
  @@index([workspaceId, toAccountId, date])
  @@index([fromAccountId, date])
  @@index([toAccountId, date])
  @@index([createdById])
  @@map("transfers")
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  token       String    @unique
  expiresAt   DateTime  @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@index([expiresAt])
  @@map("workspace_invites")
}

model PendingRegistration {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("pending_registrations")
}

model ExchangeRate {
  id           String   @id @default(cuid())
  date         DateTime @db.Timestamptz(3)
  fromCurrency Currency
  toCurrency   Currency
  rate         Float
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@unique([date, fromCurrency, toCurrency])
  @@index([date])
  @@index([fromCurrency, toCurrency])
  @@map("exchange_rates")
}

model Debt {
  id              String            @id @default(cuid())
  workspaceId     String
  type            String
  personName      String
  amount          String
  remainingAmount String
  currency        String
  date            DateTime          @default(now()) @db.Timestamptz(3)
  status          String            @default("open")
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions    DebtTransaction[]

  @@index([workspaceId, status])
  @@index([workspaceId, status, date])
  @@index([workspaceId, type, status, date])
  @@map("debts")
}

model DebtTransaction {
  id                   String              @id @default(cuid())
  workspaceId          String
  debtId               String
  accountId            String?
  paymentTransactionId String?
  type                 String
  amount               String
  toAmount             String?
  description          String?
  date                 DateTime            @default(now()) @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  debt                 Debt                @relation(fields: [debtId], references: [id], onDelete: Cascade)
  account              Account?            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)

  @@index([workspaceId, date])
  @@index([workspaceId, accountId, date])
  @@index([workspaceId, type, date])
  @@index([debtId])
  @@index([accountId])
  @@index([paymentTransactionId])
  @@map("debt_transactions")
}

model TelegramBotPreference {
  id                        String     @id @default(cuid())
  userId                    String     @unique
  telegramChatId            String?
  activeWorkspaceId         String?
  defaultAccountByWorkspace Json?      @db.JsonB
  receiptMode               String     @default("category")
  timezone                  String     @default("Europe/Minsk")
  createdAt                 DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime   @updatedAt @db.Timestamptz(3)
  user                      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspace           Workspace? @relation(fields: [activeWorkspaceId], references: [id], onDelete: SetNull)

  @@index([activeWorkspaceId])
  @@map("telegram_bot_preferences")
}

model AiFinanceDraft {
  id              String     @id @default(cuid())
  userId          String
  telegramChatId  String?
  workspaceId     String?
  status          String     @default("pending")
  sourceType      String
  sourceText      String?
  receiptMode     String?
  kind            String?
  payload         Json       @db.JsonB
  missingFields   String[]
  confidence      Float?
  currentQuestion String?
  expiresAt       DateTime   @db.Timestamptz(3)
  committedAt     DateTime?  @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, status, updatedAt])
  @@index([telegramChatId, status, updatedAt])
  @@index([workspaceId])
  @@index([expiresAt])
  @@map("ai_finance_drafts")
}

model ScheduledPayment {
  id                 String                             @id @default(cuid())
  workspaceId        String
  name               String
  amountMode         String
  amount             String?
  amountMin          String?
  amountMax          String?
  currency           String?
  categoryId         String?
  accountId          String?
  assignedUserId     String?
  createdById        String
  scheduleKind       String
  scheduleInterval   Int                                @default(1)
  scheduleUnit       String?
  dueDay             Int?
  dueMonth           Int?
  nextDueAt          DateTime                           @db.Timestamptz(3)
  timezone           String                             @default("Europe/Minsk")
  reminderDaysBefore Int[]
  notifyTelegram     Boolean                            @default(false)
  notifyEmail        Boolean                            @default(false)
  notes              String?
  lastPaidAt         DateTime?                          @db.Timestamptz(3)
  snoozedUntil       DateTime?                          @db.Timestamptz(3)
  createdAt          DateTime                           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                           @updatedAt @db.Timestamptz(3)
  workspace          Workspace                          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account            Account?                           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category           Category?                          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy          User                               @relation("ScheduledPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedUser       User?                              @relation("ScheduledPaymentAssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)
  records            ScheduledPaymentRecord[]
  reminderDeliveries ScheduledPaymentReminderDelivery[]

  @@index([workspaceId, nextDueAt])
  @@index([assignedUserId, nextDueAt])
  @@index([nextDueAt])
  @@index([accountId])
  @@index([categoryId])
  @@index([createdById])
  @@map("scheduled_payments")
}

model ScheduledPaymentRecord {
  id                 String              @id @default(cuid())
  scheduledPaymentId String
  workspaceId        String
  transactionId      String?
  dueAt              DateTime            @db.Timestamptz(3)
  paidAt             DateTime?           @db.Timestamptz(3)
  skippedAt          DateTime?           @db.Timestamptz(3)
  amount             String?
  currency           String?
  accountId          String?
  categoryId         String?
  actionById         String
  status             String
  note               String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  scheduledPayment   ScheduledPayment    @relation(fields: [scheduledPaymentId], references: [id], onDelete: Cascade)
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transaction        PaymentTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  account            Account?            @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  actionBy           User                @relation("ScheduledPaymentActionBy", fields: [actionById], references: [id], onDelete: Restrict)

  @@unique([scheduledPaymentId, dueAt])
  @@index([workspaceId, createdAt])
  @@index([transactionId])
  @@index([accountId])
  @@index([categoryId])
  @@index([actionById])
  @@map("scheduled_payment_records")
}

model ScheduledPaymentReminderDelivery {
  id                 String           @id @default(cuid())
  scheduledPaymentId String
  workspaceId        String
  userId             String
  dueAt              DateTime         @db.Timestamptz(3)
  reminderDate       DateTime         @db.Timestamptz(3)
  daysBefore         Int
  channel            String
  status             String
  sentAt             DateTime?        @db.Timestamptz(3)
  error              String?
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  scheduledPayment   ScheduledPayment @relation(fields: [scheduledPaymentId], references: [id], onDelete: Cascade)
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scheduledPaymentId, dueAt, daysBefore, channel])
  @@index([workspaceId, reminderDate])
  @@index([userId, reminderDate])
  @@map("scheduled_payment_reminder_deliveries")
}
